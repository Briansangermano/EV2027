---
import { evento } from '../data/contenido';
---

<section class="section section--crema participantes" id="participantes">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Participantes</p>
      <h2 class="h2">Un encuentro <em>para jóvenes</em></h2>
      <p class="lead">{evento.participantes.aviso}</p>
    </div>

    <div class="part__grid" data-stagger="110">
      <!-- Jóvenes -->
      <article class="part part--jovenes reveal" data-spotlight>
        <div class="part__top">
          <span class="part__tag">Jóvenes</span>
          <span class="part__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="3.4" /><path d="M4.5 21c0-4.1 3.4-7 7.5-7s7.5 2.9 7.5 7" /><path d="M17 9.5c1.7.4 3 1.9 3.2 3.8" /></svg>
          </span>
        </div>
        <p class="part__edad">{evento.participantes.jovenes.edad}</p>
        <p class="part__text">{evento.participantes.jovenes.requisito}</p>
        <p class="part__note">Traé ganas de escuchar, servir y compartir con otros jóvenes.</p>
      </article>

      <!-- Servidores -->
      <article class="part part--servidores reveal" data-spotlight>
        <div class="part__top">
          <span class="part__tag">Servidores</span>
          <span class="part__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M3 12h3M18 12h3M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" /><circle cx="12" cy="12" r="3.6" /></svg>
          </span>
        </div>
        <p class="part__edad">23 años o más</p>
        <p class="part__text">{evento.participantes.servidores.texto}</p>
        <p class="part__note">También pueden servir quienes hayan participado en conferencias o escuelas de la verdad anteriores.</p>
      </article>
    </div>

    <!-- No enviar -->
    <div class="noenviar reveal">
      <div class="noenviar__head">
        <span class="noenviar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 8v5M12 16.5v.01" /><path d="M10.3 3.9 2.7 17a2 2 0 0 0 1.7 3h15.2a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /></svg>
        </span>
        <div>
          <h3 class="noenviar__title">Por favor, no enviar jóvenes que:</h3>
          <p class="noenviar__sub">Para cuidar a todos y que la conferencia funcione como debe.</p>
        </div>
      </div>

      <ul class="noenviar__list">
        {evento.participantes.noEnviar.map((item) => (
          <li>
            <span class="noenviar__x" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .part__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.6rem);
  }

  .part {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.85rem;
    padding: clamp(1.5rem, 3vw, 2.1rem);
    border-radius: var(--r-lg);
    background: #fffdf7;
    border: 1px solid rgba(16, 36, 26, 0.09);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }
  .part::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(260px circle at var(--sx, 50%) var(--sy, 0%), rgba(44, 91, 60, 0.08), transparent 62%);
    opacity: 0;
    transition: opacity 0.45s var(--ease);
    pointer-events: none;
  }
  .part:hover::after {
    opacity: 1;
  }

  .part__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .part__tag {
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--verde);
    background: rgba(44, 91, 60, 0.08);
    border: 1px solid rgba(44, 91, 60, 0.14);
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
  }
  .part__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: var(--crema-2);
    color: var(--verde);
  }
  .part__icon svg {
    width: 23px;
    height: 23px;
  }

  .part__edad {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--ink);
  }
  .part__text {
    font-size: 0.94rem;
    line-height: 1.62;
    color: var(--ink-soft);
  }
  .part__note {
    font-size: 0.82rem;
    color: var(--ink-mute);
    padding-top: 0.85rem;
    margin-top: auto;
    border-top: 1px dashed rgba(16, 36, 26, 0.13);
  }

  .part--servidores {
    background: linear-gradient(160deg, var(--musgo-2), var(--noche)) !important;
    border-color: rgba(157, 184, 154, 0.16);
    color: var(--on-dark);
  }
  .part--servidores .part__tag {
    color: var(--sol);
    background: rgba(234, 181, 77, 0.1);
    border-color: rgba(234, 181, 77, 0.24);
  }
  .part--servidores .part__icon {
    background: rgba(255, 255, 255, 0.06);
    color: var(--crema);
  }
  .part--servidores .part__edad {
    color: var(--crema);
  }
  .part--servidores .part__text {
    color: var(--on-dark-soft);
  }
  .part--servidores .part__note {
    color: #8fa693;
    border-top-color: rgba(243, 240, 230, 0.12);
  }

  /* --- No enviar --- */
  .noenviar {
    margin-top: clamp(1rem, 2.4vw, 1.6rem);
    padding: clamp(1.4rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    background: #fbf3e4;
    border: 1px solid rgba(110, 81, 56, 0.18);
    box-shadow: var(--shadow-soft);
  }
  .noenviar__head {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .noenviar__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(110, 81, 56, 0.1);
    color: var(--corteza);
  }
  .noenviar__icon svg {
    width: 22px;
    height: 22px;
  }
  .noenviar__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .noenviar__sub {
    font-size: 0.84rem;
    color: var(--ink-mute);
    margin-top: 0.15rem;
  }

  .noenviar__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 1.4rem;
  }
  .noenviar__list li {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-soft);
    padding: 0.85rem 0.95rem;
    border-radius: var(--r-sm);
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(110, 81, 56, 0.1);
  }
  .noenviar__x {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(138, 79, 42, 0.12);
    color: #8a4f2a;
    margin-top: 1px;
  }
  .noenviar__x svg {
    width: 11px;
    height: 11px;
  }

  @media (max-width: 900px) {
    .part__grid {
      grid-template-columns: 1fr;
    }
    .noenviar__list {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { useIdioma } from '../i18n';

const { t, evento, enlaces } = useIdioma(Astro.currentLocale);
---

<section class="section section--arena inscripcion" id="inscripcion">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <!-- <p class="eyebrow">Inscripción</p> -->
      <h2 class="h2">{t.inscripcion.titulo}</h2>
      <p class="lead">{evento.inscripcion.nota}</p>
    </div>

    <!-- Fecha límite -->
    <div class="deadline reveal reveal--scale">
      <div class="deadline__left">
        <span class="deadline__label">{t.inscripcion.ultimoDia}</span>
        <p class="deadline__date">{evento.inscripcion.limite}</p>
      </div>
    </div>

    <div class="insc__grid">
      <!-- Localidades -->
      <div class="localidades reveal reveal--left">
        <div class="localidades__head">
          <span class="localidades__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V6a2 2 0 0 1 2-2h9l5 5v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z" /><path d="M8 8h5M8 12h8M8 16h6" /></svg>
          </span>
          <div>
            <h3 class="h3">{t.inscripcion.paraInscribirte}</h3>
            <p>{evento.inscripcion.localidadesNota}</p>
          </div>
        </div>

        <ul class="chips">
          {evento.inscripcion.localidades.map((l) => (
            <li><span class="chip">{l}</span></li>
          ))}
        </ul>
      </div>

      <!-- Otras localidades / contacto -->
      <div class="contacto reveal reveal--right">
        <div class="contacto__glow" aria-hidden="true"></div>
        <span class="contacto__tag">{t.inscripcion.otras}</span>
        <h3 class="h3">{t.inscripcion.noVes}</h3>
        <p class="contacto__text">{evento.inscripcion.otrasNota}</p>

        <div class="contacto__wa-row">
          <p class="contacto__num">{evento.contacto.whatsappVisible}</p>
          <a
            class="contacto__wa"
            href={enlaces.whatsapp}
            target="_blank"
            rel="noopener"
            aria-label={t.inscripcion.whatsapp}
            title={t.inscripcion.whatsapp}
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.6 2 2.2 6.4 2.2 11.84c0 1.74.46 3.44 1.32 4.94L2 22l5.36-1.4a9.8 9.8 0 0 0 4.68 1.19h.01c5.43 0 9.84-4.4 9.84-9.84 0-2.63-1.02-5.1-2.88-6.96A9.78 9.78 0 0 0 12.04 2zm5.7 13.9c-.24.67-1.4 1.28-1.93 1.33-.53.05-1.02.24-3.44-.72-2.9-1.14-4.72-4.13-4.86-4.32-.14-.19-1.14-1.52-1.14-2.9 0-1.38.72-2.06.98-2.34.26-.28.56-.35.75-.35.19 0 .38 0 .55.01.18.01.41-.07.64.49.24.57.81 1.97.88 2.11.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.16-.3.36-.43.48-.14.13-.29.28-.12.55.16.28.72 1.19 1.55 1.93 1.06.95 1.96 1.24 2.24 1.38.28.14.44.12.6-.07.16-.19.69-.8.87-1.08.19-.28.37-.23.63-.14.26.09 1.65.78 1.93.92.28.14.47.21.54.33.07.12.07.69-.17 1.36z" /></svg>
          </a>
        </div>

        <div class="contacto__divider"><span>{t.inscripcion.o}</span></div>

        <div class="contacto__mail">
          <a href={enlaces.email} class="contacto__mail-link">{evento.contacto.email}</a>
          <button
            type="button"
            class="contacto__copy"
            data-copy={evento.contacto.email}
            data-copy-label={t.inscripcion.emailCopiado}
            aria-label={t.inscripcion.copiarEmail}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2.5" /><path d="M15 5.5A2.5 2.5 0 0 0 12.5 3H6a3 3 0 0 0-3 3v6.5A2.5 2.5 0 0 0 5.5 15" /></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .inscripcion {
    position: relative;
    overflow: hidden;
  }

  /* --- Fecha límite --- */
  .deadline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.3rem, 3vw, 2rem) clamp(1.4rem, 3.5vw, 2.4rem);
    border-radius: var(--r-lg);
    background: linear-gradient(115deg, var(--noche), var(--musgo));
    color: var(--on-dark);
    margin-bottom: clamp(1rem, 2.4vw, 1.6rem);
    position: relative;
    overflow: hidden;
  }
  .deadline::after {
    content: '';
    position: absolute;
    right: -60px;
    top: -80px;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--sol) 20%, transparent), transparent 65%);
    pointer-events: none;
  }
  .deadline__label {
    display: block;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sol);
    margin-bottom: 0.4rem;
  }
  .deadline__date {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.6vw, 2.4rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--crema);
  }
  .deadline__pill {
    display: inline-block;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--salvia) 28%, transparent);
    font-size: 0.78rem;
    color: var(--on-dark-soft);
    white-space: nowrap;
  }

  /* --- Grid --- */
  .insc__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(1rem, 2.4vw, 1.6rem);
  }

  .localidades {
    padding: clamp(1.4rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--tarjeta);
    border: 1px solid color-mix(in srgb, var(--ink) 9%, transparent);
    box-shadow: var(--shadow-soft);
    display: grid;
    gap: 1.4rem;
    align-content: start;
  }
  .localidades__head {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .localidades__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: color-mix(in srgb, var(--verde) 8%, transparent);
    color: var(--verde);
    border: 1px solid color-mix(in srgb, var(--verde) 14%, transparent);
  }
  .localidades__icon svg {
    width: 22px;
    height: 22px;
  }
  .localidades__head p {
    font-size: 0.88rem;
    color: var(--ink-mute);
    margin-top: 0.15rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* --- Contacto --- */
  .contacto {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    background: linear-gradient(165deg, var(--musgo-2), var(--noche));
    color: var(--on-dark);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }
  .contacto__glow {
    position: absolute;
    width: 300px;
    height: 300px;
    right: -120px;
    bottom: -140px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--verde-2) 35%, transparent), transparent 65%);
    pointer-events: none;
  }
  .contacto__tag {
    justify-self: start;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sol);
    border: 1px solid color-mix(in srgb, var(--sol) 30%, transparent);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
  }
  .contacto .h3 {
    color: var(--crema);
    margin-top: 0.2rem;
  }
  .contacto__text {
    font-size: 0.9rem;
    color: var(--on-dark-soft);
    line-height: 1.6;
  }
  .contacto__wa-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 0.5rem;
  }
  .contacto__num {
    font-size: 0.95rem;
    color: var(--crema);
    letter-spacing: 0.04em;
  }
  .contacto__wa {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--sol);
    color: var(--noche);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .contacto__wa:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--sol) 35%, transparent);
  }
  .contacto__wa svg {
    width: 20px;
    height: 20px;
  }

  .contacto__divider {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--salvia);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .contacto__divider::before,
  .contacto__divider::after {
    content: '';
    height: 1px;
    flex: 1;
    background: color-mix(in srgb, var(--salvia) 20%, transparent);
  }

  .contacto__mail {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .contacto__mail-link {
    font-size: 0.86rem;
    color: var(--crema);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--on-dark) 30%, transparent);
    transition: color 0.3s, border-color 0.3s;
    word-break: break-all;
  }
  .contacto__mail-link:hover {
    color: var(--sol);
    border-color: var(--sol);
  }
  .contacto__copy {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--salvia) 25%, transparent);
    background: transparent;
    color: var(--salvia);
    cursor: pointer;
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }
  .contacto__copy svg {
    width: 15px;
    height: 15px;
  }
  .contacto__copy:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--crema);
  }
  .contacto__copy.is-copied {
    background: var(--sol);
    border-color: var(--sol);
    color: var(--noche);
  }

  @media (max-width: 900px) {
    .insc__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .deadline {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .deadline__pill {
      white-space: normal;
    }
  }
</style>

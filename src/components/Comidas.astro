---
import { useIdioma } from '../i18n';

const { t, evento } = useIdioma(Astro.currentLocale);

/** Íconos en orden: desayuno, almuerzo, merienda, cena. Los nombres vienen de contenido.ts */
const iconosComidas = [
  {
    icono: '<path d="M4 8h12v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8z"/><path d="M16 9h2.5a2.5 2.5 0 0 1 0 5H16"/><path d="M7 3v2M11 3v2M3 22h18"/>',
  },
  {
    icono: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/>',
  },
  {
    icono: '<path d="M4 10h12v3.5A5.5 5.5 0 0 1 10.5 19h-1A5.5 5.5 0 0 1 4 13.5V10z"/><path d="M16 11h2.4a2.1 2.1 0 0 1 0 4.2H16"/><path d="M7.5 3.5c0 1-1 1.2-1 2.2M11.5 3.5c0 1-1 1.2-1 2.2"/>',
  },
  {
    icono: '<path d="M20 14.5A8 8 0 0 1 9.5 4 8.2 8.2 0 1 0 20 14.5z"/>',
  },
];
const comidas = evento.comidas.comidas.map((nombre, i) => ({ nombre, icono: iconosComidas[i]?.icono ?? '' }));

const svg = (inner: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
---

<section class="section section--noche comidas" id="comidas">
  <div class="comidas__glow" aria-hidden="true"></div>

  <div class="container">
    <div class="section-head section-head--center reveal">
      <!-- <p class="eyebrow">Comidas</p> -->
      <h2 class="h2">{t.comidas.titulo}</h2>
      <p class="lead">{evento.comidas.texto}</p>
    </div>

    <!-- Timeline de comidas -->
    <div class="meals-wrap reveal">
      <div class="meals__line" aria-hidden="true"></div>
      <ol class="meals">
        {comidas.map((c) => (
          <li>
            <span class="meals__dot" aria-hidden="true">
              <Fragment set:html={svg(c.icono)} />
            </span>
            <span class="meals__name">{c.nombre}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="rango reveal">
      <div class="rango__item">
        <span class="rango__label">{t.comidas.comienza}</span>
        <span class="rango__value">{evento.comidas.inicio}</span>
        <span class="rango__hint">{evento.fechas.inicio.corto}</span>
      </div>
      <div class="rango__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6" /></svg>
      </div>
      <div class="rango__item rango__item--end">
        <span class="rango__label">{t.comidas.finaliza}</span>
        <span class="rango__value">{evento.comidas.fin}</span>
        <span class="rango__hint">{evento.fechas.fin.corto}</span>
      </div>
    </div>

    <!-- Avisos -->
    <div class="avisos" data-stagger="110">
      {evento.comidas.avisos.map((a, i) => (
        <article class="aviso reveal">
          <span class="aviso__icon" aria-hidden="true">
            {i === 0 ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c4.5-4 7-7.4 7-11a7 7 0 1 0-14 0c0 3.6 2.5 7 7 11z" /><path d="M12 8v4M12 15.5v.01" /></svg>
            )}
          </span>
          <div>
            <h3 class="aviso__title">{a.titulo}</h3>
            <p class="aviso__text">{a.texto}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .comidas {
    position: relative;
    overflow: hidden;
  }
  .comidas__glow {
    position: absolute;
    width: 700px;
    height: 700px;
    left: 50%;
    top: -380px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--sol) 10%, transparent), transparent 66%);
    pointer-events: none;
  }

  .meals-wrap {
    position: relative;
    margin-top: 1rem;
  }
  .meals__line {
    position: absolute;
    top: 2.35rem;
    left: 12.5%;
    right: 12.5%;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--salvia) 35%, transparent), color-mix(in srgb, var(--salvia) 35%, transparent), transparent);
  }
  .meals {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .meals li {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.8rem;
  }
  .meals__dot {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: linear-gradient(160deg, var(--musgo-2), var(--noche-2));
    border: 1px solid color-mix(in srgb, var(--sol) 22%, transparent);
    color: var(--sol);
    box-shadow: 0 0 0 8px var(--noche), 0 18px 30px -18px rgba(0, 0, 0, 0.7);
    transition: transform 0.5s var(--ease), border-color 0.4s, background-color 0.4s;
  }
  .meals__dot :global(svg) {
    width: 30px;
    height: 30px;
  }
  .meals li:hover .meals__dot {
    transform: translateY(-5px) scale(1.04);
    border-color: color-mix(in srgb, var(--sol) 55%, transparent);
  }
  .meals__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--crema);
  }

  /* --- Rango --- */
  .rango {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 4vw, 3rem);
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.2rem, 3vw, 1.8rem) clamp(1.4rem, 4vw, 2.6rem);
    border-radius: var(--r-lg);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid color-mix(in srgb, var(--salvia) 16%, transparent);
  }
  .rango__item {
    display: grid;
    gap: 0.15rem;
  }
  .rango__item--end {
    text-align: right;
  }
  .rango__label {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia);
  }
  .rango__value {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.4vw, 1.5rem);
    letter-spacing: -0.02em;
    color: var(--crema);
  }
  .rango__hint {
    font-size: 0.75rem;
    color: var(--salvia-mute);
  }
  .rango__arrow {
    color: var(--sol);
    opacity: 0.7;
  }
  .rango__arrow svg {
    width: 34px;
    height: 34px;
  }

  /* --- Avisos --- */
  .avisos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.6rem);
    margin-top: clamp(1rem, 2.4vw, 1.6rem);
  }
  .aviso {
    display: flex;
    gap: 1rem;
    padding: clamp(1.2rem, 2.6vw, 1.6rem);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid color-mix(in srgb, var(--salvia) 14%, transparent);
    transition: border-color 0.4s, background-color 0.4s;
  }
  .aviso:hover {
    border-color: color-mix(in srgb, var(--sol) 28%, transparent);
    background: rgba(255, 255, 255, 0.05);
  }
  .aviso__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--sol) 10%, transparent);
    color: var(--sol);
  }
  .aviso__icon svg {
    width: 22px;
    height: 22px;
  }
  .aviso__title {
    font-family: var(--font-display);
    font-size: 1.08rem;
    letter-spacing: -0.01em;
    color: var(--crema);
    margin-bottom: 0.25rem;
  }
  .aviso__text {
    font-size: 0.87rem;
    line-height: 1.55;
    color: var(--on-dark-soft);
  }

  @media (max-width: 640px) {
    .meals__line {
      display: none;
    }
    .meals {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.6rem 1rem;
    }
    .rango {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .rango__item--end {
      text-align: left;
    }
    .rango__arrow {
      transform: rotate(90deg);
      align-self: center;
    }
    .avisos {
      grid-template-columns: 1fr;
    }
  }
</style>

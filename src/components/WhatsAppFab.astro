<style>
  .fab {
    position: fixed;
    right: 1.1rem;
    bottom: max(1.1rem, env(safe-area-inset-bottom));
    z-index: 95;
    display: none;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--whatsapp);
    color: var(--on-whatsapp);
    box-shadow: 0 14px 30px -10px color-mix(in srgb, var(--whatsapp) 65%, transparent);
    transition: transform 0.4s var(--ease), box-shadow 0.4s;
  }
  .fab svg {
    width: 30px;
    height: 30px;
    position: relative;
    z-index: 1;
  }
  .fab:hover {
    transform: translateY(-3px) scale(1.04);
  }
  .fab__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--whatsapp) 55%, transparent);
    animation: fab-pulse 2.8s ease-out infinite;
  }
  @keyframes fab-pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.7);
      opacity: 0;
    }
  }

  @media (max-width: 980px) {
    .fab {
      display: grid;
    }
  }
</style>

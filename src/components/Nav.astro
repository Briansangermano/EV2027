---
import { useIdioma, idiomas, nombresIdioma, rutaIdioma } from '../i18n';

const { lang, t, evento } = useIdioma(Astro.currentLocale);

const enlaces = [
  { href: '#fechas', label: t.nav.lugar },
  { href: '#pago', label: t.nav.pago },
  { href: '#inscripcion', label: t.nav.inscripcion },
  { href: '#regulaciones', label: t.nav.regulaciones },
  { href: '#info', label: t.nav.preparativos },
];

const menu = [
  { href: '#inicio', label: t.nav.inicio },
  { href: '#fechas', label: t.nav.lugar },
  { href: '#pago', label: t.nav.pago },
  { href: '#inscripcion', label: t.nav.inscripcion },
  { href: '#regulaciones', label: t.nav.regulaciones },
  { href: '#participantes', label: t.nav.participantes },
  { href: '#materiales', label: t.nav.materiales },
];
---

<header class="nav" data-nav>
  <div class="nav__progress" aria-hidden="true"><span data-progress></span></div>

  <div class="nav__inner container">
    <a class="nav__brand" href="#inicio" aria-label={t.nav.irInicio}>
      <span class="nav__mark" aria-hidden="true">EV
      </span>
      <span class="nav__name">
        <strong>{t.nav.marcaFuerte}</strong>
        <em>{t.nav.marcaSub}</em>
      </span>
    </a>

    <nav class="nav__links" aria-label={t.nav.secciones}>
      {enlaces.map((e) => <a href={e.href}>{e.label}</a>)}
    </nav>

    <!-- <a class="btn btn--sol btn--sm nav__cta" href="#inscripcion">
      Inscripción
      <span class="btn__icon" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </span>
    </a> -->

    <nav
      class="nav__lang"
      aria-label={t.nav.cambiarIdioma}
      data-lang-switch
      style={`--idx:${idiomas.indexOf(lang)};--n:${idiomas.length}`}
    >
      <span class="nav__lang-thumb" aria-hidden="true"></span>
      {idiomas.map((l, i) => (
        <a
          href={rutaIdioma(l)}
          hreflang={l}
          lang={l}
          data-idx={i}
          aria-current={l === lang ? 'page' : undefined}
          title={nombresIdioma[l]}
        >
          {l.toUpperCase()}
        </a>
      ))}
    </nav>

    <button
      class="nav__toggle"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="menu-movil"
      aria-label={t.nav.abrirMenu}
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="nav__panel" id="menu-movil" data-menu>
    <nav class="nav__panel-inner" aria-label={t.nav.menuMovil}>
      {menu.map((m, i) => (
        <a href={m.href} style={`--i:${i}`}>
          <span class="nav__panel-num">{String(i + 1).padStart(2, '0')}</span>
          {m.label}
        </a>
      ))}
    </nav>
    <div class="nav__panel-foot">
      <p>{evento.fechas.textoAnio}</p>
      <p>{evento.lugar.nombre} · {evento.lugar.ciudad}</p>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    color: var(--on-dark);
  }
  /* El fondo y el blur van en un pseudo-elemento: si backdrop-filter estuviera en
     .nav, el panel móvil (position: fixed) quedaría atrapado dentro del header. */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    border-bottom: 1px solid transparent;
    transition: background-color 0.45s var(--ease), border-color 0.45s var(--ease);
  }
  .nav.is-scrolled::before {
    background: color-mix(in srgb, var(--noche) 94%, transparent);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    border-bottom-color: color-mix(in srgb, var(--on-dark) 9%, transparent);
  }

  .nav__progress {
    position: absolute;
    z-index: 3;
    inset: 0 0 auto 0;
    height: 2px;
    background: color-mix(in srgb, var(--on-dark) 6%, transparent);
  }
  .nav__progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--verde-2), var(--sol));
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.12s linear;
  }

  .nav__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 76px;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    margin-right: auto;
  }
  .nav__mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: linear-gradient(160deg, var(--verde-2), var(--verde));
    color: var(--crema);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }
  .nav__mark {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.98rem;
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .nav__name {
    display: grid;
    line-height: 1.05;
  }
  .nav__name strong {
    font-family: var(--font-display);
    font-size: 1.06rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding-bottom: 4px;
  }
  .nav__name em {
    font-family: var(--font-body);
    font-style: normal;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .nav__links a {
    position: relative;
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    font-size: 0.87rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--on-dark-soft);
    transition: color 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.3rem;
    height: 1px;
    background: var(--sol);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.35s var(--ease);
  }
  .nav__links a:hover {
    color: var(--crema);
  }
  .nav__links a:hover::after {
    transform: scaleX(1);
  }

  /* Selector de idioma */
  .nav__lang {
    --pad: 3px;
    position: relative;
    display: inline-grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    padding: var(--pad);
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--on-dark) 18%, transparent);
    background: color-mix(in srgb, var(--noche) 40%, transparent);
    isolation: isolate;
  }
  /* Píldora detrás del idioma activo */
  .nav__lang-thumb {
    position: absolute;
    z-index: -1;
    top: var(--pad);
    bottom: var(--pad);
    left: var(--pad);
    width: calc((100% - 2 * var(--pad)) / var(--n));
    border-radius: 999px;
    background: linear-gradient(160deg, var(--sol-2), var(--sol));
    box-shadow: 0 4px 14px -4px color-mix(in srgb, var(--sol) 70%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    transform: translateX(calc(var(--idx) * 100%));
  }
  .nav__lang a {
    min-width: 2.25rem;
    padding: 0.4rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    text-decoration: none;
    color: var(--on-dark-soft);
    transition: color 0.35s var(--ease), transform 0.35s var(--ease);
  }
  .nav__lang a:hover {
    color: var(--crema);
  }
  .nav__lang a:active {
    transform: scale(0.92);
  }
  .nav__lang a[aria-current='page'] {
    color: var(--on-sol);
  }
  .nav__lang a:focus-visible {
    outline: 2px solid var(--sol);
    outline-offset: 2px;
  }

  .nav__cta {
    padding: 0.7rem 1.1rem;
  }

  .nav__toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--on-dark) 24%, transparent);
    background: transparent;
    color: var(--crema);
    cursor: pointer;
    padding: 0;
  }
  .nav__toggle span {
    position: absolute;
    left: 50%;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.4s var(--ease), opacity 0.3s;
  }
  .nav__toggle span:first-child {
    top: 18px;
    transform: translateX(-50%);
  }
  .nav__toggle span:last-child {
    top: 24px;
    transform: translateX(-50%);
  }
  .nav__toggle[aria-expanded='true'] span:first-child {
    transform: translateX(-50%) translateY(3px) rotate(45deg);
  }
  .nav__toggle[aria-expanded='true'] span:last-child {
    transform: translateX(-50%) translateY(-3px) rotate(-45deg);
  }

  /* Panel móvil */
  .nav__panel {
    position: fixed;
    inset: 0;
    z-index: 1;
    /* Flex + márgenes auto: centra cuando hay espacio, pero si el contenido no entra
       se puede scrollear completo (align-content: center recortaba los extremos).
       Sin height explícito: inset: 0 se ajusta al viewport visible real. */
    display: flex;
    flex-direction: column;
    gap: 2rem;
    overflow-y: auto;
    overscroll-behavior: none;
    -webkit-overflow-scrolling: touch;
    padding: 6rem var(--gutter) calc(3rem + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(180deg, var(--noche), var(--noche-2));
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease), visibility 0.45s;
  }
  .nav__panel.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .nav__panel-inner {
    display: grid;
    gap: 0.15rem;
    width: min(100%, 460px);
    margin: auto auto 0;
  }
  .nav__panel-inner a {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.85rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 7vw, 2.2rem);
    /* Sin esto hereda el line-height 1.68 del body y el panel desborda por poco */
    line-height: 2.5rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--crema);
    border-bottom: 1px solid color-mix(in srgb, var(--on-dark) 8%, transparent);
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease), color 0.3s;
    transition-delay: calc(var(--i) * 45ms + 80ms);
  }
  .nav__panel.is-open .nav__panel-inner a {
    opacity: 1;
    transform: none;
  }
  .nav__panel-inner a:hover {
    color: var(--sol);
  }
  .nav__panel-num {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--salvia);
  }
  .nav__panel-foot {
    width: min(100%, 460px);
    margin: 0 auto auto;
    padding-top: 1rem;
    color: var(--on-dark-soft);
    font-size: 0.85rem;
    display: grid;
    gap: 0.2rem;
  }

  /* Pantallas bajas (teléfonos chicos, landscape): menú más compacto */
  @media (max-height: 700px) {
    .nav__panel {
      gap: 1.25rem;
      padding-top: 2.5rem;
      padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    }
    .nav__panel-inner a {
      padding: 0.4rem 0;
      font-size: clamp(1.35rem, 5.5vw, 1.8rem);
    }
  }

  /* Bloquear el scroll de la página detrás del menú. Tiene que ir en <html>: como
     html tiene overflow-x: clip, el overflow de body no se propaga al viewport. */
  :global(html:has(body.menu-open)),
  :global(body.menu-open) {
    overflow: hidden;
  }

  @media (max-width: 980px) {
    .nav__inner {
      background: var(--noche);
    }
    .nav__links {
      display: none;
    }
    .nav__cta {
      display: none;
    }
    .nav__toggle {
      display: block;
    }
  }
</style>

---
import { evento, enlaces } from '../data/contenido';

const [leer, firmar] = evento.regulaciones.pasos;
---

<section class="section section--noche regulaciones" id="regulaciones">
  <div class="regulaciones__glow" aria-hidden="true"></div>

  <div class="container">
    <div class="section-head section-head--center reveal">
      <h2 class="h2">Regulaciones</h2>
      <p class="lead">{evento.regulaciones.nota}</p>
    </div>

    <ol class="reg__grid">
      <li class="reg reveal reveal--left">
        <span class="reg__step">Paso 01</span>
        <span class="reg__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h8l5 5v13H6z" /><path d="M14 3v5h5" /><path d="M9.5 12h6M9.5 15.5h6M9.5 19h3.5" /></svg>
        </span>
        <h3 class="h3">{leer.titulo}</h3>
        <p class="reg__text">{leer.texto}</p>
        <div class="reg__actions">
          <a class="btn btn--ghost btn--sm" href={enlaces.regulacionesPdf} target="_blank" rel="noopener">
            Ver PDF
          </a>
          <a class="btn btn--ghost btn--sm" href={enlaces.regulacionesPdf} download="Regulaciones - Escuela de la verdad.pdf">
            Descargar
            <span class="btn__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12M6 11l6 6 6-6M5 20h14" /></svg>
            </span>
          </a>
        </div>
      </li>

      <li class="reg reg--sol reveal reveal--right">
        <span class="reg__step">Paso 02</span>
        <span class="reg__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z" /><path d="M14 6l3 3" /><path d="M13 21h8" /></svg>
        </span>
        <h3 class="h3">{firmar.titulo}</h3>
        <p class="reg__text">{firmar.texto}</p>
        <div class="reg__actions">
          <a class="btn btn--sol btn--sm" href={enlaces.regulacionesForm} target="_blank" rel="noopener">
            Firmar regulaciones
            <span class="btn__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </a>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .regulaciones {
    position: relative;
    overflow: hidden;
  }
  .regulaciones__glow {
    position: absolute;
    width: 560px;
    height: 560px;
    left: -220px;
    bottom: -260px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--verde-2) 22%, transparent), transparent 65%);
    pointer-events: none;
  }

  .reg__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.6rem);
    max-width: 920px;
    margin-inline: auto;
    list-style: none;
    padding: 0;
  }

  .reg {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    border: 1px solid color-mix(in srgb, var(--salvia) 16%, transparent);
    background: rgba(255, 255, 255, 0.03);
  }
  .reg--sol {
    border-color: color-mix(in srgb, var(--sol) 30%, transparent);
    background: linear-gradient(165deg, var(--musgo-2), var(--noche));
    box-shadow: var(--shadow-lift);
  }

  .reg__step {
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sol);
  }
  .reg__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    background: color-mix(in srgb, var(--sol) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--sol) 16%, transparent);
    color: var(--sol);
    margin: 0.2rem 0;
  }
  .reg__icon svg {
    width: 24px;
    height: 24px;
  }
  .reg .h3 {
    color: var(--crema);
  }
  .reg__text {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--on-dark-soft);
  }
  .reg__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }

  @media (max-width: 760px) {
    .reg__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

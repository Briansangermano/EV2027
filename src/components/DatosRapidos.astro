---
import { evento } from '../data/contenido';

const datos = [
  {
    label: 'Fechas',
    value: `${evento.fechas.inicio.numero} — ${evento.fechas.fin.numero} de ${evento.fechas.inicio.mes}`,
    sub: `${evento.fechas.inicio.dia} a ${evento.fechas.fin.dia}`,
    href: '#fechas',
    icon: 'calendario',
  },
  {
    label: 'Lugar',
    value: evento.lugar.nombre,
    sub: `${evento.lugar.ciudad}, ${evento.lugar.provincia}`,
    href: '#fechas',
    icon: 'pin',
  },
  {
    label: 'Edades',
    value: '11 a 22 años',
    sub: 'Jóvenes · servidores 23+',
    href: '#participantes',
    icon: 'gente',
  },
  {
    label: 'Tasa',
    value: evento.pago.precioTexto,
    href: '#pago',
    icon: 'billete',
  },
];
---

<section class="facts" aria-label="Datos rápidos del evento">
  <div class="container">
    <div class="facts__grid" data-stagger="90">
      {datos.map((d) => (
        <a class="fact reveal" href={d.href} data-spotlight>
          <span class="fact__icon" aria-hidden="true">
            {d.icon === 'calendario' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M8 3v4M16 3v4M3 10h18" /><path d="M8 14h3" /></svg>
            )}
            {d.icon === 'pin' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11z" /><circle cx="12" cy="10" r="2.6" /></svg>
            )}
            {d.icon === 'gente' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="9" cy="8" r="3.2" /><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5" /><path d="M16 5.2A3 3 0 0 1 18.5 11M17.5 14.6c2.3.5 4 2.4 4 5.4" /></svg>
            )}
            {d.icon === 'billete' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="2.5" y="6" width="19" height="12" rx="2.5" /><circle cx="12" cy="12" r="2.6" /><path d="M6 9.5v.01M18 14.5v.01" /></svg>
            )}
          </span>
          <span class="fact__body">
            <span class="fact__label">{d.label}</span>
            <strong class="fact__value">{d.value}</strong>
            <span class="fact__sub">{d.sub}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .facts {
    position: relative;
    background: var(--noche);
    color: var(--on-dark);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .facts__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .fact {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.25rem 1.15rem;
    border-radius: 18px;
    border: 1px solid color-mix(in srgb, var(--salvia) 16%, transparent);
    background: rgba(255, 255, 255, 0.025);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.45s var(--ease), border-color 0.45s var(--ease), background-color 0.45s var(--ease);
  }
  .fact::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(240px circle at var(--sx, 50%) var(--sy, 50%), color-mix(in srgb, var(--sol) 12%, transparent), transparent 60%);
    opacity: 0;
    transition: opacity 0.45s var(--ease);
    pointer-events: none;
  }
  .fact:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--sol) 35%, transparent);
    background: rgba(255, 255, 255, 0.045);
  }
  .fact:hover::after {
    opacity: 1;
  }

  .fact__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--sol) 10%, transparent);
    color: var(--sol);
    border: 1px solid color-mix(in srgb, var(--sol) 18%, transparent);
  }
  .fact__icon svg {
    width: 21px;
    height: 21px;
  }

  .fact__body {
    display: grid;
    gap: 0.1rem;
    line-height: 1.25;
  }
  .fact__label {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salvia);
  }
  .fact__value {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--crema);
  }
  .fact__sub {
    font-size: 0.76rem;
    color: var(--on-dark-soft);
  }

  @media (max-width: 900px) {
    .facts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 420px) {
    .facts__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

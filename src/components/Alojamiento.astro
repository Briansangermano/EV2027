---
import { evento } from '../data/contenido';
---

<section class="section section--crema alojamiento" id="alojamiento">
  <div class="container">
    <div class="section-head reveal">
      <!-- <p class="eyebrow">Alojamiento</p> -->
      <h2 class="h2">Alojamiento</h2>
      <p class="lead">
        El predio les proveerá cama y almohada. El resto del equipaje corre por tu cuenta, así que
        armá la valija con tiempo.
      </p>
    </div>

    <div class="alo__grid">
      <!-- Traer -->
      <div class="traer reveal">
        <div class="traer__head">
          <span class="traer__tag">Traé en tu valija</span>
          <span class="traer__count">{String(evento.alojamiento.traer.length).padStart(2, '0')} ítems</span>
        </div>

        <ul class="traer__list">
          {evento.alojamiento.traer.map((item) => (
            <li>
              <span class="traer__box" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7" /></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>

        <p class="traer__note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 11v5M12 7.8v.01" /></svg>
          ¿Dudas con el equipaje? Contactate con los servidores de tu localidad.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .alo__grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  /* --- Traer (estilos del antiguo box "provee") --- */
  .traer {
    display: grid;
    align-content: start;
    gap: 1.4rem;
    padding: clamp(1.5rem, 3vw, 2.1rem);
    border-radius: var(--r-lg);
    background: linear-gradient(160deg, var(--musgo-2), var(--noche));
    color: var(--on-dark);
    box-shadow: var(--shadow-lift);
  }
  .traer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .traer__tag {
    display: inline-block;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sol);
    border: 1px solid rgba(234, 181, 77, 0.3);
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
  }
  .traer__count {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    color: var(--crema);
  }

  .traer__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .traer__list li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1rem;
    border-radius: var(--r-sm);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(157, 184, 154, 0.14);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--crema);
  }
  .traer__box {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgba(234, 181, 77, 0.12);
    color: var(--sol);
  }
  .traer__box svg {
    width: 17px;
    height: 17px;
  }

  .traer__note {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(243, 240, 230, 0.12);
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--on-dark-soft);
  }
  .traer__note svg {
    flex: 0 0 auto;
    width: 19px;
    height: 19px;
    margin-top: 2px;
    color: var(--salvia);
  }

  @media (max-width: 900px) {
    .traer__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .traer__list {
      grid-template-columns: 1fr;
    }
  }
</style>

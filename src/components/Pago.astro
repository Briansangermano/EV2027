---
import { useIdioma } from '../i18n';

const { t, evento } = useIdioma(Astro.currentLocale);
---

<section class="section section--noche pago" id="pago">
  <div class="contours" aria-hidden="true"></div>
  <div class="pago__glow" aria-hidden="true"></div>

  <div class="container pago__inner">
    <div class="pago__copy reveal reveal--left">
      <!-- <p class="eyebrow">Pago</p> -->
      <h2 class="h2">{t.pago.titulo}</h2>
      <p class="lead">
        {evento.pago.descripcion}
      </p>

      <div class="pago__como">
        <span class="pago__como-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5 12 4l9 4.5-9 4.5-9-4.5z" /><path d="M3 8.5V16l9 4.5 9-4.5V8.5" /><path d="M12 13v7.5" /></svg>
        </span>
        <div>
          <p class="pago__como-title">{t.pago.comoTitulo}</p>
          <p class="pago__como-text">{evento.pago.nota}</p>
        </div>
      </div>
    </div>

    <!-- Ticket -->
    <article class="ticket reveal reveal--right" data-spotlight>
      <div class="ticket__head">
        <span class="ticket__label">{t.pago.tasaLabel}</span>
      </div>

      <div class="ticket__price">
        <span class="ticket__currency">$</span>
        <span class="ticket__amount" data-count={evento.precio}>{new Intl.NumberFormat(t.js.numberLocale).format(evento.precio)}</span>
      </div>
      <p class="ticket__includes">{evento.pago.incluye}</p>

      <div class="ticket__perf" aria-hidden="true"></div>

      <div class="ticket__extra">
        <div class="ticket__extra-head">
          <span class="ticket__extra-amount">{evento.pago.libroTexto}</span>
          <span class="ticket__extra-tag">{t.pago.opcional}</span>
        </div>
        <p class="ticket__extra-text">{evento.pago.libroDetalle}</p>
      </div>


      <div class="ticket__extra">
        <div class="ticket__extra-head">
          <span class="ticket__extra-amount">{evento.pago.recargoTexto}</span>
          <span class="ticket__extra-tag">{t.pago.recargo}</span>
        </div>
        <p class="ticket__extra-text">{evento.pago.recargoDetalle}</p>
      </div>

      <a class="ticket__cta" href="#inscripcion">
        {t.pago.irInscripcion}
        <span class="btn__icon" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
      </a>
    </article>
  </div>
</section>

<style>
  .pago {
    position: relative;
    overflow: hidden;
  }
  .pago__glow {
    position: absolute;
    width: 620px;
    height: 620px;
    left: -180px;
    bottom: -260px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--verde-2) 22%, transparent), transparent 65%);
    pointer-events: none;
  }
  .pago__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .pago__copy {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .pago__copy .h2 {
    color: var(--crema);
  }
  .pago__copy .h2 em {
    color: var(--sol);
  }
  .pago__copy .lead {
    max-width: 46ch;
  }

  .pago__como {
    display: flex;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid color-mix(in srgb, var(--salvia) 16%, transparent);
    margin-top: 0.4rem;
  }
  .pago__como-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--sol) 12%, transparent);
    color: var(--sol);
  }
  .pago__como-icon svg {
    width: 22px;
    height: 22px;
  }
  .pago__como-title {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--crema);
    margin-bottom: 0.15rem;
  }
  .pago__como-text {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--on-dark-soft);
  }
  .pago__fine {
    font-size: 0.8rem;
    color: var(--salvia-mute);
    max-width: 42ch;
  }

  /* --- Ticket --- */
  .ticket {
    position: relative;
    padding: clamp(1.6rem, 3.5vw, 2.3rem);
    border-radius: var(--r-lg);
    background: linear-gradient(170deg, var(--tarjeta) 0%, var(--crema-3) 100%);
    color: var(--ink);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }
  .ticket::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(300px circle at var(--sx, 50%) var(--sy, 0%), color-mix(in srgb, var(--sol) 18%, transparent), transparent 65%);
    pointer-events: none;
  }

  .ticket__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .ticket__label {
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .ticket__tag {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--noche);
    background: var(--sol);
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
  }

  .ticket__price {
    display: flex;
    align-items: flex-start;
    gap: 0.3rem;
    margin-top: 1rem;
    line-height: 1;
  }
  .ticket__currency {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    color: var(--verde);
    padding-top: 0.35em;
  }
  .ticket__amount {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 4.6rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    font-variant-numeric: lining-nums;
    color: var(--ink);
  }
  .ticket__includes {
    margin-top: 0.35rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .ticket__perf {
    position: relative;
    height: 1px;
    margin: 1.5rem -2.3rem;
    background-image: linear-gradient(90deg, color-mix(in srgb, var(--ink) 28%, transparent) 50%, transparent 50%);
    background-size: 12px 1px;
  }
  .ticket__perf::before,
  .ticket__perf::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--noche);
    transform: translateY(-50%);
  }
  .ticket__perf::before {
    left: -11px;
  }
  .ticket__perf::after {
    right: -11px;
  }

  .ticket__extra {
    margin-top: 1rem;
  }

  .ticket__extra-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .ticket__extra-amount {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--corteza);
  }
  .ticket__extra-tag {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--oxido);
    background: color-mix(in srgb, var(--corteza) 12%, transparent);
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
  }
  .ticket__extra-text {
    font-size: 0.85rem;
    color: var(--ink-mute);
  }

  .ticket__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.4rem;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--verde);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, gap 0.3s var(--ease);
  }
  .ticket__cta:hover {
    border-color: currentColor;
    gap: 0.75rem;
  }

  @media (max-width: 900px) {
    .pago__inner {
      grid-template-columns: 1fr;
    }
    .ticket {
      max-width: 480px;
    }
  }
  @media (max-width: 640px) {
    .ticket {
      max-width: none;
    }
    .ticket__perf {
      margin-inline: -1.6rem;
    }
  }
</style>

---
import { useIdioma } from '../i18n';

const { t, evento } = useIdioma(Astro.currentLocale);

const frases = [
  evento.referencia,
  evento.fechas.texto,
  evento.lugar.nombre,
  `${evento.lugar.ciudad}, ${evento.lugar.provincia}`,
];
---

<div class="band" aria-hidden="true">
  <div class="marquee">
    <div class="marquee__track">
      {[0, 1].map(() => (
        <div class="marquee__group">
          {frases.map((f) => (
            <>
              <span class="marquee__item">{f}</span>
              <span class="marquee__star">✦</span>
            </>
          ))}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .band {
    position: relative;
    z-index: 2;
    padding-block: 1.8rem;
    background: var(--noche);
    overflow: hidden;
  }
  .band :global(.marquee) {
    transform: rotate(-1.4deg) scale(1.04);
    border-color: color-mix(in srgb, var(--on-dark) 12%, transparent);
  }
</style>

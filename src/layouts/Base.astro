---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { temaCSS, themeColor } from '../data/tema';
import { useIdioma, idiomas, idiomaPorDefecto, rutaIdioma } from '../i18n';

const { lang, t, evento } = useIdioma(Astro.currentLocale);

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${evento.titulo} · ${evento.etiqueta} ${evento.anio}`,
  description = t.meta.descripcion(
    evento.titulo,
    evento.fechas.textoAnio,
    evento.lugar.nombre,
    evento.lugar.ciudad,
    evento.inscripcion.limite,
  ),
} = Astro.props;

const site = Astro.site ?? 'https://ev2027.com';
const canonical = new URL(Astro.url.pathname, site);
const alternativas = idiomas.map((l) => ({ lang: l, href: new URL(rutaIdioma(l), site).href }));
const ogLocaleAlt = idiomas.filter((l) => l !== lang).map((l) => (l === 'es' ? 'es_AR' : 'en_US'));
---

<!doctype html>
<html lang={lang} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {alternativas.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(rutaIdioma(idiomaPorDefecto), site).href} />
    <meta name="theme-color" content={themeColor} />
    <style is:inline set:html={temaCSS()}></style>
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {ogLocaleAlt.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/og-image.jpg', canonical).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.jpg', canonical).href} />

    <ClientRouter />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t.meta.saltar}</a>
    <slot />
    <div class="noise" aria-hidden="true"></div>

    <script is:inline type="application/json" id="i18n" set:html={JSON.stringify(t.js)} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

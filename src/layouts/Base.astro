---
import '../styles/global.css';
import { evento } from '../data/contenido';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${evento.titulo} · ${evento.etiqueta} ${evento.anio}`,
  description = `${evento.titulo}. ${evento.fechas.textoAnio} en ${evento.lugar.nombre}, ${evento.lugar.ciudad}. Inscripción hasta el ${evento.inscripcion.limite}.`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://ev2027.com');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#07160E" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/og-image.jpg', canonical).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.jpg', canonical).href} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <div class="noise" aria-hidden="true"></div>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

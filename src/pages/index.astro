---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import DatosRapidos from '../components/DatosRapidos.astro';
import Marquee from '../components/Marquee.astro';
import FechasLugar from '../components/FechasLugar.astro';
import Pago from '../components/Pago.astro';
import Inscripcion from '../components/Inscripcion.astro';
import Regulaciones from '../components/Regulaciones.astro';
import Participantes from '../components/Participantes.astro';
import Materiales from '../components/Materiales.astro';
import Alojamiento from '../components/Alojamiento.astro';
import Comidas from '../components/Comidas.astro';
import Cierre from '../components/Cierre.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
---

<Base>
  <Nav />
  <main id="contenido">
    <Hero />
    <DatosRapidos />
    <Marquee />
    <FechasLugar />
    <Pago />
    <Inscripcion />
    <Regulaciones />
    <Participantes />
    <span id="info"></span>
    <Materiales />
    <Alojamiento />
    <Comidas />
    <Cierre />
  </main>
  <Footer />
  <WhatsAppFab />
</Base>
